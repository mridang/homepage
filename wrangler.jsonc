{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homepage",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The Worker entry: Astro's handler wrapped in the shared HTTP pipeline.
  "main": "src/worker.ts",
  // The `ASSETS` binding is injected by @astrojs/cloudflare at build time.

  // Cloudflare auto-routes the Worker to the colo closest to the viewer.
  "placement": { "mode": "smart" },
  // Full Workers Observability: logs, metrics, invocation traces — all
  // sampled at 100%. The volume on a single-page site is tiny.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
  },
  // Custom domain — the workers.dev subdomain is disabled so the
  // canonical URL is the apex we control. The mrida.ng zone must be
  // attached to this Cloudflare account for the custom_domain bind to
  // succeed.
  "workers_dev": false,
  "routes": [{ "pattern": "mrida.ng", "custom_domain": true }],
  // The release id, so cached pages are keyed to the release that made them.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Cloudflare Workers Rate Limiting: the first line of defence, checked in the
  // Worker before the app is touched (src/lib/core/http/edge-limits.ts). A page
  // served from the edge copy still counts. Limits are per Cloudflare location
  // and eventually consistent: a cost guard, not an accounting system.
  // namespace_id is account-wide and shared by every Worker that uses the same
  // number, hence the distinctive 74xx range.
  "ratelimits": [
    // pictures, per person (unused here, kept so every app declares the same set)
    {
      "name": "RL_COVER",
      "namespace_id": "7401",
      "simple": { "limit": 600, "period": 60 },
    },
    // the rest of the API, per person
    {
      "name": "RL_API",
      "namespace_id": "7402",
      "simple": { "limit": 120, "period": 60 },
    },
    // well-known documents, health and crawler files, per address
    {
      "name": "RL_DISCOVERY",
      "namespace_id": "7403",
      "simple": { "limit": 120, "period": 60 },
    },
    // browser reports (what the CSP blocked), per address
    {
      "name": "RL_REPORTS",
      "namespace_id": "7404",
      "simple": { "limit": 60, "period": 60 },
    },
    // pages, per address
    {
      "name": "RL_SITE",
      "namespace_id": "7405",
      "simple": { "limit": 300, "period": 60 },
    },
    // everything, per address
    {
      "name": "RL_ADDRESS",
      "namespace_id": "7406",
      "simple": { "limit": 900, "period": 60 },
    },
  ],
}
