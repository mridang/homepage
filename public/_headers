# Cloudflare Workers Assets header rules.

# Content-hashed build output — the filename changes whenever the bytes
# change, so it is safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts — filenames are stable and the bytes never change, so
# cache them for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Un-hashed public files — cache for a day; they change rarely.
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/mask-icon.svg
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400
