# Cloudflare Workers Assets header rules.

# Security headers for the prerendered page and every static asset (Workers
# assets answer these without running the Worker). src/middleware.ts sets the
# same values for Worker-rendered responses such as 404s, and
# src/headers.test.ts keeps the two in step.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  Origin-Agent-Cluster: ?1

# The prerendered HTML page.
/
  Cache-Control: public, max-age=300

# Content-hashed build output — the filename changes whenever the bytes
# change, so it is safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts — filenames are stable and the bytes never change, so
# cache them for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Un-hashed public files — cache for a day; they change rarely. Icons are
# loaded by other sites and browsers on purpose, so they are cross-origin.
/favicon.svg
  Cache-Control: public, max-age=86400
  Cross-Origin-Resource-Policy: cross-origin
/favicon.ico
  Cache-Control: public, max-age=86400
  Cross-Origin-Resource-Policy: cross-origin
/mask-icon.svg
  Cache-Control: public, max-age=86400
  Cross-Origin-Resource-Policy: cross-origin
/*.png
  Cache-Control: public, max-age=86400
  Cross-Origin-Resource-Policy: cross-origin
