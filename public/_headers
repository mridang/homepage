# Cloudflare Workers Assets header rules for static files. They bypass the
# Worker, so the security headers it adds to pages are repeated here (a test
# keeps the two lists in step). Later, more specific rules add to these. They
# also override OpenNext's default `max-age=0, must-revalidate` on assets.
# The same in every app.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Resource-Policy: same-site
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  Origin-Agent-Cluster: ?1
  Cross-Origin-Opener-Policy: same-origin

# Content-hashed build output — the filename changes whenever the bytes
# change, so it is safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts — filenames are stable and the bytes never change, so
# cache them for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Un-hashed public files — cache for a day; they change rarely. The icons and
# the social card are also files other sites and browsers load on purpose.
/favicon.svg
  Cache-Control: public, max-age=86400
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
/favicon.ico
  Cache-Control: public, max-age=86400
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
/mask-icon.svg
  Cache-Control: public, max-age=86400
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
/*.png
  Cache-Control: public, max-age=86400
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
/robots.txt
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
/sitemap.xml
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
