  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@mridang/eslint-defaults": "^1.6.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.1",
    "cypress": "^14.5.4",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "knip": "^6.17.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.101.0"
