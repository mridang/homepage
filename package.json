{
  "name": "homepage",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "astro dev",
    "astro": "astro",
    "cf-typegen": "wrangler types",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "format": "prettier --write .",
