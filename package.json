    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@mridang/eslint-defaults": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "cypress": "^16.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.101.0"
  }
