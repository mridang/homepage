{
  "name": "homepage",
  "version": "0.1.0",
  "description": "My personal homepage, a single, fully server-rendered page running on Cloudflare Workers.",
  "type": "module",
  "private": true,
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "cf-typegen": "wrangler types && prettier --write worker-configuration.d.ts",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "preview": "astro preview",
    "start": "astro dev",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "test:watch": "npm run test -- --watch",
    "typecheck": "astro check"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.0.3",
    "@mridang/eslint-defaults": "^2.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "cypress": "^16.2.1",
    "eslint": "^10.14.0",
    "jest": "^30.0.3",
    "jest-junit": "^17.0.0",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "@eslint/core": "1.2.1"
  }
}
