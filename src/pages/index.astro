---
import Layout from '../layouts/Layout.astro';

// Footer social links. Icon paths are the design's own marks, inlined so
// they inherit currentColor for the hover state.
const socials = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/mridang/',
    path: 'M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5zM3 9h4v12H3V9zm6 0h3.8v1.64h.05c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21H9V9z',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/mridang',
    path: 'M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.36 9.36 0 0 1 12 6.84c.85 0 1.71.12 2.51.34 1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.35 4.79-4.58 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z',
  },
  {
    label: 'Medium',
    href: 'https://medium.com/@mridang.agarwalla',
    path: 'M13.54 12a6.77 6.77 0 1 1-13.54 0 6.77 6.77 0 0 1 13.54 0zm7.42 0c0 3.54-1.51 6.42-3.38 6.42s-3.39-2.88-3.39-6.42 1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42zM24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75S24 8.83 24 12z',
  },
];
---

<Layout>
  <div class="screen">
    <header class="masthead">
      <div class="logo">MRIDA<span class="logo-italic">NG</span></div>
      <div class="pronunciation" tabindex="0" aria-describedby="call-me-mika">
        <span class="pos">n.</span>
        <span class="ipa">/mriˈdɑːːŋ/</span>
        <span class="tip" id="call-me-mika" role="tooltip"
          >…or you can just call me “Mika”. 😅</span
        >
      </div>
    </header>

    <main class="lede">
      <h1 class="headline">
        I build calm, considered software for the web<span class="accent"
          >.</span
        >
      </h1>
      <p class="sub">
        An engineer who designs — clean systems, fast iterations, and interfaces
        that earn their place. Currently building something new.
      </p>
    </main>

    <footer class="footer">
      <div class="rule"></div>
      <nav class="socials" aria-label="Social and contact links">
        {
          socials.map((s) => (
            <a
              class="social"
              href={s.href}
              aria-label={s.label}
              target="_blank"
              rel="me noopener noreferrer"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={s.path} />
              </svg>
            </a>
          ))
        }
        {
          /* Email icon. The mailto is assembled by JS so the address never
             appears in the server-rendered HTML — nothing for a scraper to
             harvest. It starts `hidden` so no-JS clients don't see a dead,
             unfocusable icon; the script reveals it once it's a real link. */
        }
        <a
          id="contact-email"
          class="social"
          aria-label="Email"
          rel="nofollow"
          hidden
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6zm-2 0-8 5-8-5h16zm0 12H4V8l8 5 8-5v10z"
            ></path>
          </svg>
        </a>
      </nav>
    </footer>
  </div>

  <script>
    // Processed (not is:inline) so Astro's CSP hashes it. Assembles the
    // mailto from split parts so the address never appears in the HTML.
    (function () {
      const a = document.getElementById('contact-email');
      if (!a) return;
      const user = ['cont', 'act'].join('');
      const domain = ['mrida', 'ng'].join('.');
      a.setAttribute('href', 'mailto:' + user + '@' + domain);
      a.hidden = false;
    })();
  </script>
</Layout>

<style>
  .screen {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 7vh 7vw;
  }

  .masthead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .logo {
    font-weight: 800;
    font-size: clamp(34px, 3.4vw, 50px);
    letter-spacing: 0.003em;
    line-height: 1;
    white-space: nowrap;
    color: var(--accent);
  }

  .logo-italic {
    font-style: italic;
  }

  .pronunciation {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 11px 5px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: clamp(12px, 0.95vw, 14px);
    letter-spacing: 0.01em;
    color: var(--muted);
    cursor: help;
  }

  .pronunciation:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .pronunciation .pos {
    font-weight: 500;
    font-style: italic;
    color: var(--accent);
  }

  .pronunciation .ipa {
    font-weight: 400;
  }

  .pronunciation .tip {
    position: absolute;
    top: calc(100% + 9px);
    left: 0;
    z-index: 2;
    white-space: nowrap;
    padding: 7px 11px;
    border-radius: 9px;
    background: var(--head);
    color: var(--bg);
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .pronunciation .tip::after {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 18px;
    border: 5px solid transparent;
    border-bottom-color: var(--head);
  }

  .pronunciation:hover .tip,
  .pronunciation:focus-visible .tip {
    opacity: 1;
    transform: translateY(0);
  }

  .lede {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    text-align: left;
  }

  .headline {
    margin: 0;
    max-width: 17ch;
    font-weight: 700;
    font-size: clamp(36px, 4.6vw, 78px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--head);
  }

  .headline .accent {
    color: var(--accent);
  }

  .sub {
    margin: 28px 0 0;
    max-width: 46ch;
    font-weight: 400;
    font-size: clamp(16px, 1.45vw, 21px);
    line-height: 1.5;
    color: var(--muted);
  }

  .footer {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .rule {
    height: 1px;
    width: 100%;
    background: var(--rule);
  }

  .socials {
    display: flex;
    gap: 18px;
    justify-content: flex-start;
  }

  .social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--rule);
    color: var(--body);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .social:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* The class sets display:inline-flex, which would otherwise beat the UA
     [hidden] rule and show the not-yet-wired email icon. */
  .social[hidden] {
    display: none;
  }

  .social:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .social svg {
    width: 20px;
    height: 20px;
  }
</style>
