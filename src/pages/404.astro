---
// The page served for any address that does not exist.

/**
 * @file The page shown for any address that does not exist.
 */
import Layout from '../layouts/layout.astro';
---

<Layout title="Page not found — Mridang Agarwalla" noindex>
  <main className="missing">
    <p className="eyebrow">404</p>
    {/* eslint-disable react/no-unescaped-entities -- the apostrophe is literal text, and the e2e test matches it */}
    <h1 className="title">We couldn't find that page</h1>
    {/* eslint-enable react/no-unescaped-entities -- end of the disabled element */}
    <p className="note">
      The address leads nowhere. The home page is the only one here.
    </p>
    <a className="back" href="/">
      {' '}
      Back to the home page{' '}
    </a>
  </main>
</Layout>

<style>
  .missing {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 14px;
    padding: 7vh 7vw;
  }

  .eyebrow {
    margin: 0;
    font-weight: 800;
    font-style: italic;
    font-size: clamp(34px, 3.4vw, 50px);
    color: var(--accent);
  }

  .title {
    margin: 0;
    max-width: 17ch;
    font-weight: 700;
    font-size: clamp(30px, 4vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--head);
  }

  .note {
    margin: 0;
    color: var(--muted);
  }

  .back {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
